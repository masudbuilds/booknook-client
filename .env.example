# BookNook Client Environment Variables

# Express Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Better Auth Application URL (base URL of your Next.js deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Secret key used for Better Auth sessions (minimum 32 characters)
BETTER_AUTH_SECRET=your_better_auth_secret_key_here

# Shared JWT secret key (must match JWT_SECRET in booknook-server)
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection (used by Better Auth for users, accounts, and sessions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=booknook

# Google OAuth Credentials (Optional: leave empty if using Email/Password authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB API Key (Optional: used for uploading book cover images via Add Book form)
NEXT_PUBLIC_IMGBB_API_KEY=

